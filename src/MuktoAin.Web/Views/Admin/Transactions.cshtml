@model IReadOnlyList<MuktoAin.Application.DTOs.PaymentOrderDto>
@{
    ViewData["Title"] = "Transactions — Admin — MuktoAin";
    ViewData["IsAdminPage"] = true;
    var payouts = (IReadOnlyList<MuktoAin.Domain.Entities.PayoutRequest>?)ViewData["Payouts"] ?? new List<MuktoAin.Domain.Entities.PayoutRequest>();
    // RefundOrder / ApprovePayout are [Authorize(Policy = "SuperAdminOnly")].
    var isSuperAdmin = User.HasClaim("IsSuperAdmin", "true");
}

@functions {
    private static string ToBn(object? val)
    {
        if (val == null) return string.Empty;
        var bnDigits = new[] { '০', '১', '২', '৩', '৪', '৫', '৬', '৭', '৮', '৯' };
        var s = val.ToString()!;
        var chars = s.Select(c => (c >= '0' && c <= '9') ? bnDigits[c - '0'] : c).ToArray();
        return new string(chars);
    }
}

<main class="container" id="main">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a asp-controller="Admin" asp-action="Dashboard" data-bn="ড্যাশবোর্ড" data-en="Dashboard">Dashboard</a>
        <span class="sep">/</span>
        <span data-bn="লেনদেনসমূহ" data-en="Transactions">Transactions</span>
    </nav>

    <div class="page-head">
        <span class="kicker"><i data-lucide="receipt"></i> FR-24</span>
        <h1 class="page-title" data-bn="লেনদেন ও অর্থপ্রদান অডিট" data-en="Transactions">Transactions</h1>
        <p class="page-sub">
            <span class="badge badge-warn sandbox-badge" 
                  data-bn="ডেমো মোড — সিমুলেটেড গেটওয়ে (বাস্তব টাকা নয়)" 
                  data-en="Demo Mode — Simulated Gateway (no real money)">
                ডেমো মোড — সিমুলেটেড গেটওয়ে / Simulated gateway — no real money
            </span>
        </p>
    </div>

    <div class="card" style="margin-bottom: 20px">
        <h2 class="section-h">
            <i data-lucide="landmark"></i>
            <span data-bn="পেমেন্ট অর্ডারসমূহ" data-en="Orders">Orders</span>
        </h2>
        <table>
            <thead>
                <tr>
                    <th data-bn="অর্ডার নং" data-en="Order">Order</th>
                    <th data-bn="উদ্দেশ্য" data-en="Purpose">Purpose</th>
                    <th data-bn="মামলা" data-en="Case">Case</th>
                    <th data-bn="মোট পরিমাণ" data-en="Amount">Amount</th>
                    <th data-bn="কমিশন" data-en="Commission">Commission</th>
                    <th data-bn="আইনজীবীর প্রাপ্য" data-en="Net to lawyer">Net to lawyer</th>
                    <th data-bn="অবস্থা" data-en="Status">Status</th>
                    <th data-bn="পদক্ষেপ" data-en="Actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model)
                {
                    <tr>
                        <td class="mono">
                            #@o.PaymentOrderId<br />
                            <small class="muted">@o.CreatedAt.ToString("d MMM HH:mm")</small>
                        </td>
                        <td>@o.Purpose</td>
                        <td>@(o.CaseId.HasValue ? $"CASE-{o.CaseId}" : "—")</td>
                        <td>
                            <span data-bn="৳@ToBn(o.Amount)" data-en="৳@o.Amount">৳@o.Amount</span>
                        </td>
                        <td>
                            <span data-bn="৳@ToBn(o.Commission)" data-en="৳@o.Commission">৳@o.Commission</span>
                        </td>
                        <td>
                            <span data-bn="৳@ToBn(o.NetToLawyer)" data-en="৳@o.NetToLawyer">৳@o.NetToLawyer</span>
                            @(o.LawyerName != null ? $" · {o.LawyerName}" : "")
                        </td>
                        <td>
                            @if (o.Status == "Paid")
                            {
                                <span class="badge badge-final" data-bn="পরিশোধিত" data-en="Paid">Paid</span>
                            }
                            else if (o.Status == "Refunded")
                            {
                                <span class="badge badge-neutral" data-bn="রিফান্ডকৃত" data-en="Refunded">Refunded</span>
                            }
                            else if (o.Status == "Failed")
                            {
                                <span class="badge badge-rejected" data-bn="ব্যর্থ" data-en="Failed">Failed</span>
                            }
                            else
                            {
                                <span class="badge badge-draft" data-bn="অপেক্ষমান" data-en="@o.Status">@o.Status</span>
                            }
                        </td>
                        <td>
                            @* Orders become Paid only through the gateway (PaymentService.ConfirmPaymentAsync). *@
                            @if (o.Status == "Paid" && !isSuperAdmin)
                            {
                                <small class="muted" data-bn="কেবল সুপার-অ্যাডমিন" data-en="SuperAdmin only">SuperAdmin only</small>
                            }
                            else if (o.Status == "Paid")
                            {
                                <form asp-action="RefundOrder" method="post" style="display:inline"
                                      data-confirm="এই অর্ডারের টাকা রিফান্ড করে লেজার সমন্বয় করবেন? / Refund this order and reverse the ledger?"
                                      data-confirm-title="রিফান্ড নিশ্চিতকরণ / Refund Confirmation"
                                      data-confirm-ok="রিফান্ড করুন / Refund"
                                      data-confirm-cancel="বাতিল / Cancel">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="orderId" value="@o.PaymentOrderId" />
                                    <button class="btn btn-danger-outline btn-sm" type="submit" data-bn="রিফান্ড করুন" data-en="Refund">Refund</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="muted" style="text-align:center"
                            data-bn="কোনো অর্ডার পাওয়া যায়নি।" data-en="No orders yet.">
                            No orders yet.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="card">
        <h2 class="section-h">
            <i data-lucide="banknote"></i>
            <span data-bn="উত্তোলন / পে-আউট অনুরোধ" data-en="Payout requests">Payout requests</span>
        </h2>
        @if (payouts != null && payouts.Any())
        {
            <table>
                <thead>
                    <tr>
                        <th data-bn="রিকোয়েস্ট নং" data-en="Request">Request</th>
                        <th data-bn="আইনজীবী" data-en="Lawyer">Lawyer</th>
                        <th data-bn="পরিমাণ" data-en="Amount">Amount</th>
                        <th data-bn="অনুরোধের সময়" data-en="Requested">Requested</th>
                        <th data-bn="পদক্ষেপ" data-en="Action">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in payouts)
                    {
                        <tr>
                            <td class="mono">#@p.PayoutRequestId</td>
                            <td>
                                <span data-bn="আইনজীবী #@ToBn(p.LawyerProfileId)" data-en="Lawyer #@p.LawyerProfileId">Lawyer #@p.LawyerProfileId</span>
                            </td>
                            <td>
                                <span data-bn="৳@ToBn(p.Amount)" data-en="৳@p.Amount">৳@p.Amount</span>
                            </td>
                            <td>@p.RequestedAt.ToString("d MMM HH:mm")</td>
                            <td>
                                @if (isSuperAdmin)
                                {
                                    <form asp-action="ApprovePayout" method="post" style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="payoutRequestId" value="@p.PayoutRequestId" />
                                        <button class="btn btn-outline btn-sm" type="submit" data-bn="অনুমোদন → পরিশোধ চিহ্নিত করুন" data-en="Approve → mark paid">Approve → mark paid</button>
                                    </form>
                                }
                                else
                                {
                                    <small class="muted" data-bn="কেবল সুপার-অ্যাডমিন" data-en="SuperAdmin only">SuperAdmin only</small>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="muted" data-bn="কোনো অপেক্ষমান পে-আউট অনুরোধ নেই।" data-en="No pending payout requests.">No pending payout requests.</p>
        }
    </div>
</main>

