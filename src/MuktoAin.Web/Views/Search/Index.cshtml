@model MuktoAin.Web.ViewModels.SearchViewModel
@{
    ViewData["Title"] = "আইন অনুসন্ধান — Search Acts";

    // Display-only numeral and title script helpers
    static bool IsBengali(string? text) =>
        !string.IsNullOrEmpty(text) && text.Any(c => c >= '\u0980' && c <= '\u09FF');

    static string ToBnDigits(string? text) =>
        string.IsNullOrEmpty(text)
            ? string.Empty
            : text.Select(c => (c >= '0' && c <= '9') ? (char)(c - '0' + '০') : c)
                  .Aggregate(new System.Text.StringBuilder(), (sb, c) => sb.Append(c))
                  .ToString();

    static string ToEnDigits(string? text) =>
        string.IsNullOrEmpty(text)
            ? string.Empty
            : text.Select(c => (c >= '০' && c <= '৯') ? (char)(c - '০' + '0') : c)
                  .Aggregate(new System.Text.StringBuilder(), (sb, c) => sb.Append(c))
                  .ToString();

    static string ToBn(int n) => ToBnDigits(n.ToString());

    static string FormatSectionRef(string actTitle, string? sectionNumber)
    {
        if (string.IsNullOrWhiteSpace(sectionNumber)) return actTitle;
        var isBn = IsBengali(actTitle);
        var secFormatted = isBn ? ToBnDigits(sectionNumber) : ToEnDigits(sectionNumber);
        var prefix = isBn ? "ধারা" : "Section";
        return $"{actTitle}, {prefix} {secFormatted}";
    }

    static string FormatSectionLabel(string actTitle, string? sectionNumber)
    {
        if (string.IsNullOrWhiteSpace(sectionNumber)) return actTitle;
        var isBn = IsBengali(actTitle);
        var secFormatted = isBn ? ToBnDigits(sectionNumber) : ToEnDigits(sectionNumber);
        var prefix = isBn ? "ধারা" : "Section";
        return $"{prefix} {secFormatted}";
    }

    var totalPages = Model.PageSize > 0
        ? (int)Math.Ceiling(Model.TotalResults / (double)Model.PageSize)
        : 1;
}

<main class="container" id="main">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a asp-controller="Home" asp-action="Index">Home</a>
        <span class="sep">/</span>
        <span>আইন অনুসন্ধান</span>
    </nav>

    <!-- Search Hero -->
    <div class="search-hero">
        <span class="kicker"><i data-lucide="search"></i> Statutory Full-Text Search · FR-7</span>
        <h1 class="page-title">বাংলাদেশের আইন সংকলনে খুঁজুন</h1>
        <p class="page-sub" style="margin: 0 auto 1.25rem;">১,৪৮৪টি পূর্ণাঙ্গ আইন ও ৩৫,০০০+ ধারা থেকে সরাসরি কীওয়ার্ড, ধারা নম্বর বা বিষয়বস্তু খুঁজুন</p>

        <form method="get" asp-action="Index" class="search-bar">
            <div class="search-box">
                <i data-lucide="search" class="search-box-icon"></i>
                <input name="q" value="@Model.Query" class="search-box-input" placeholder="কীওয়ার্ড লিখুন... (যেমন: মজুরি, ক্ষতিপূরণ, ধারা ১২৩, ট্রেড ইউনিয়ন)" autocomplete="off" autofocus />
                @if (!string.IsNullOrEmpty(Model.Query))
                {
                    <a asp-action="Index" class="search-box-clear" title="ক্লিয়ার করুন" aria-label="Clear query">
                        <i data-lucide="x"></i>
                    </a>
                }
                <button type="submit" class="btn btn-primary search-box-btn">
                    <i data-lucide="search"></i> <span>খুঁজুন</span>
                </button>
            </div>

            @if (Model.HasSearched)
            {
                var allActs = (List<MuktoAin.Domain.Entities.Act>)ViewBag.Acts;
                var selectedAct = allActs.FirstOrDefault(a => a.ActId == Model.ActId);
                var isActFiltered = selectedAct != null;
                var selectedLabel = selectedAct == null ? "সব আইন / All acts" : $"{selectedAct.Title} ({selectedAct.Year})";

                // Prominent national statutes
                var keyPatterns = new[]
                {
                    "শ্রম আইন", "ভোক্তা-অধিকার", "তথ্য অধিকার", "দণ্ডবিধি", "ফৌজদারি কার্যবিধি",
                    "দেওয়ানি কার্যবিধি", "নারী ও শিশু নির্যাতন", "সম্পত্তি হস্তান্তর", "সুনির্দিষ্ট প্রতিকার",
                    "সাক্ষ্য আইন", "হস্তান্তরযোগ্য দলিল", "অর্থ ঋণ আদালত", "পারিবারিক সহিংসতা",
                    "সাইবার নিরাপত্তা", "ডিজিটাল নিরাপত্তা", "দুর্নীতি দমন"
                };

                var topActs = allActs
                    .Where(a => keyPatterns.Any(p => a.Title.Contains(p, StringComparison.OrdinalIgnoreCase)))
                    .OrderBy(a => a.Title)
                    .Take(15)
                    .ToList();

                var categoryGroups = new (string Name, string[] Keywords)[]
                {
                    ("🏢 শ্রম ও কর্মসংস্থান", new[] { "শ্রম", "labour", "মজুরি", "ইপিজেড", "কর্মসংস্থান" }),
                    ("🛡️ ভোক্তা ও খাদ্য অধিকার", new[] { "ভোক্তা", "consumer", "খাদ্য", "ওজন", "পরিমাপ", "মান নিয়ন্ত্রণ" }),
                    ("📄 নাগরিক ও তথ্য অধিকার", new[] { "তথ্য অধিকার", "information", "মানবাধিকার", "নাগরিক" }),
                    ("⚖️ জমিজমা ও দেওয়ানি প্রতিকার", new[] { "সম্পত্তি", "property", "ভূমি", "land", "সুনির্দিষ্ট প্রতিকার", "ইমারত", "জরিপ" }),
                    ("🚔 ফৌজদারি ও দণ্ডবিধি", new[] { "দণ্ডবিধি", "penal", "ফৌজদারি", "criminal", "অস্ত্র", "মাদক", "পুলিশ" }),
                    ("👩‍👧 নারী, শিশু ও পরিবার", new[] { "নারী", "শিশু", "পারিবারিক", "যৌতুক", "বিবাহ", "তালাক", "অভিভাবক", "বাল্যবিবাহ" }),
                    ("💳 ব্যাংক, চেক ও অর্থ ঋণ", new[] { "অর্থ ঋণ", "ব্যাংক", "হস্তান্তরযোগ্য দলিল", "চেক", "মানিলন্ডারিং", "বীমা" }),
                    ("💻 সাইবার ও ডিজিটাল", new[] { "সাইবার", "ডিজিটাল", "তথ্য ও যোগাযোগ", "টেলিকমিউনিケーション" })
                };

                <div class="search-meta-line">
                    <div class="act-filter" data-act-filter>
                        <input type="hidden" name="actId" id="actId-value" value="@Model.ActId" />
                        <button type="button" class="act-filter-btn @(isActFiltered ? "active-filter" : "")" id="actId-btn" aria-haspopup="listbox" aria-expanded="false" title="@selectedLabel">
                            <i data-lucide="book" class="act-filter-icon"></i>
                            <span id="actId-label">@selectedLabel</span>
                            <i data-lucide="chevron-down" class="act-filter-chevron"></i>
                        </button>
                        <div class="act-filter-panel" id="actId-panel" hidden>
                            <div class="act-filter-list" id="actId-list" role="listbox" tabindex="-1">
                                <div class="act-filter-item @(selectedAct == null ? "selected" : "")" role="option" data-value="">
                                    <i data-lucide="layers" class="item-icon"></i>
                                    <span class="item-text"><b>সব আইন / All acts</b></span>
                                </div>

                                <div class="act-filter-section-header">
                                    <i data-lucide="star" class="section-icon"></i>
                                    <span>শীর্ষ প্রধান আইনসমূহ / Key Statutes</span>
                                </div>
                                @foreach (var act in topActs)
                                {
                                    var label = $"{act.Title} ({act.Year})";
                                    var isSelected = act.ActId == Model.ActId;
                                    <div class="act-filter-item @(isSelected ? "selected" : "")" role="option" data-value="@act.ActId" title="@label">
                                        <i data-lucide="bookmark" class="item-icon item-star"></i>
                                        <span class="item-text">@label</span>
                                    </div>
                                }

                                <div class="act-filter-section-header">
                                    <i data-lucide="folder" class="section-icon"></i>
                                    <span>আইনের প্রধান ক্ষেত্রসমূহ / Legal Domains</span>
                                </div>
                                @foreach (var cat in categoryGroups)
                                {
                                    var actsInCat = allActs
                                        .Where(a => cat.Keywords.Any(k => a.Title.Contains(k, StringComparison.OrdinalIgnoreCase)))
                                        .Take(8)
                                        .ToList();

                                    if (actsInCat.Count > 0)
                                    {
                                        <div class="act-category-header">
                                            <span>@cat.Name</span>
                                            <span class="cat-count">(@actsInCat.Count)</span>
                                        </div>
                                        @foreach (var act in actsInCat)
                                        {
                                            var label = $"{act.Title} ({act.Year})";
                                            var isSelected = act.ActId == Model.ActId;
                                            <div class="act-filter-item act-filter-subitem @(isSelected ? "selected" : "")" role="option" data-value="@act.ActId" title="@label">
                                                <i data-lucide="file-text" class="item-icon"></i>
                                                <span class="item-text">@label</span>
                                            </div>
                                        }
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="search-meta-line">
                    <div class="popular-chips-wrap">
                        <span class="tiny muted popular-label">জনপ্রিয়:</span>
                        <a class="chip chip-sm" asp-action="Index" asp-route-q="মজুরি পরিশোধ">মজুরি পরিশোধ</a>
                        <a class="chip chip-sm" asp-action="Index" asp-route-q="ধারা ১২৩">ধারা ১২৩</a>
                        <a class="chip chip-sm" asp-action="Index" asp-route-q="তথ্য অধিকার">তথ্য অধিকার</a>
                        <a class="chip chip-sm" asp-action="Index" asp-route-q="দণ্ডবিধি ৪২০">দণ্ডবিধি ৪২০</a>
                    </div>
                </div>
            }
        </form>
    </div>

    @if (Model.HasSearched)
    {
        <div class="with-rail" style="margin-top: 2rem;">
            <!-- Main Results Column -->
            <div class="stack" style="gap: 16px;">
                <div class="row spread wrap" style="padding-bottom: 8px; border-bottom: 1px solid var(--border);">
                    <span class="tiny muted">
                        @if (!string.IsNullOrEmpty(Model.Query))
                        {
                            <text>“<b>@Model.Query</b>”-এর জন্য প্রায় <b>@Model.TotalResults টি ফলাফল</b> পাওয়া গেছে (পৃষ্ঠা @Model.Page)</text>
                        }
                        else
                        {
                            @* Act-only browse: no keyword was searched, so phrase the count around the Act instead of a quoted query. *@
                            <text>নির্বাচিত আইনে মোট <b>@Model.TotalResults টি ধারা</b> পাওয়া গেছে (পৃষ্ঠা @Model.Page)</text>
                        }
                    </span>
                </div>

                @if (Model.Results.Count > 0)
                {
                    <div class="stack" style="gap: 14px;">
                        @foreach (var res in Model.Results)
                        {
                            var formattedTitle = FormatSectionRef(res.ActTitle, res.SectionNumber);
                            var sectionLabel = FormatSectionLabel(res.ActTitle, res.SectionNumber);
                            var isBnTitle = IsBengali(res.ActTitle);

                            <div class="card result-item">
                                <div class="row spread wrap" style="margin-bottom: 6px;">
                                    <div class="r-title">
                                        <i data-lucide="bookmark" style="color:var(--gold)"></i>
                                        <b class="serif">@formattedTitle</b>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(res.ActNumber) && res.ActNumber != "NaN" && res.ActYear > 0)
                                    {
                                        <span class="badge badge-neutral">
                                            <span class="i18n-bn">আইন নং @ToBnDigits(res.ActNumber)/@ToBn(res.ActYear)</span>
                                            <span class="i18n-en" style="display:none">Act No. @ToEnDigits(res.ActNumber)/@res.ActYear</span>
                                        </span>
                                    }
                                </div>
                                <div class="r-snippet">
                                    @* Act-only browse has no keyword to highlight -- String.Replace throws on
                                       an empty oldValue, so skip highlighting entirely in that case. *@
                                    @if (string.IsNullOrEmpty(Model.Query))
                                    {
                                        @res.SectionTextSnippet
                                    }
                                    else
                                    {
                                        var encodedSnippet = System.Net.WebUtility.HtmlEncode(res.SectionTextSnippet);
                                        var terms = Model.Query
                                            .Split(new[] { ' ', '\t', '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries)
                                            .Select(t => System.Text.RegularExpressions.Regex.Escape(System.Net.WebUtility.HtmlEncode(t)))
                                            .Distinct()
                                            .ToList();

                                        if (terms.Count > 0)
                                        {
                                            var pattern = string.Join("|", terms);
                                            var highlighted = System.Text.RegularExpressions.Regex.Replace(
                                                encodedSnippet,
                                                $"({pattern})",
                                                "<mark>$1</mark>",
                                                System.Text.RegularExpressions.RegexOptions.IgnoreCase);
                                            @Html.Raw(highlighted)
                                        }
                                        else
                                        {
                                            @encodedSnippet
                                        }
                                    }
                                </div>
                                <div class="row spread wrap" style="margin-top: 12px; padding-top: 10px; border-top: 1px dashed var(--border);">
                                    <div class="row wrap" style="gap: 14px;">
                                        <a class="tiny" href="#"
                                           data-copy="@formattedTitle"
                                           data-copy-msg-bn="@(string.IsNullOrWhiteSpace(res.SectionNumber) ? res.ActTitle : (isBnTitle ? sectionLabel : $"Section {ToEnDigits(res.SectionNumber)}")) ক্লিপবোর্ডে কপি হয়েছে"
                                           data-copy-msg-en="@(string.IsNullOrWhiteSpace(res.SectionNumber) ? res.ActTitle : $"Section {ToEnDigits(res.SectionNumber)}") copied to clipboard"
                                           onclick="return false;">
                                            <i data-lucide="copy"></i> <span data-bn="ধারা উদ্ধৃতি কপি" data-en="Copy Section Citation">ধারা উদ্ধৃতি কপি</span>
                                        </a>
                                        @if (res.IsTruncated)
                                        {
                                            <a class="tiny" href="#" data-open-modal="#section-modal-@res.SectionId" onclick="return false;">
                                                <i data-lucide="maximize-2"></i> <span data-bn="সম্পূর্ণ ধারা দেখুন" data-en="View Full Section">সম্পূর্ণ ধারা দেখুন</span>
                                            </a>
                                        }
                                    </div>
                                    <div class="row wrap" style="gap: 8px;">
                                        @if (!User.IsInRole("Lawyer"))
                                        {
                                            <a class="chip chip-sm" asp-controller="Home" asp-action="Index"
                                               asp-route-prefill='@($"এই ধারাটি আমার মামলায় প্রযোজ্য কি? {res.ActTitle} {(string.IsNullOrWhiteSpace(res.SectionNumber) ? "" : sectionLabel)}")'>
                                                AI-কে জিজ্ঞেস করুন
                                            </a>
                                        }
                                        @if (!User.IsInRole("Lawyer"))
                                        {
                                            <a class="btn btn-quiet btn-sm" asp-controller="Case" asp-action="Submit"
                                               data-bn="এই ধারা উদ্ধৃত করে মামলা দাখিল →" data-en="File a Case Citing This Section →">
                                                এই ধারা উদ্ধৃত করে মামলা দাখিল →
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>

                            @if (res.IsTruncated)
                            {
                                <div class="modal-backdrop" id="section-modal-@res.SectionId" role="dialog" aria-modal="true" aria-labelledby="section-modal-title-@res.SectionId">
                                    <div class="modal reading-modal">
                                        <div class="modal-handle"></div>
                                        <div class="modal-head">
                                            <h3 class="serif" id="section-modal-title-@res.SectionId">@formattedTitle</h3>
                                            <button class="icon-btn" type="button" data-close-modal aria-label="Close modal">
                                                <i data-lucide="x"></i>
                                            </button>
                                        </div>
                                        <div class="section-full-text" style="max-height: 60vh; overflow-y: auto; margin-top: 8px;">
                                            @if (res.SectionClauses.Count > 0)
                                            {
                                                <p style="margin: 0 0 10px;">@res.SectionIntro</p>
                                                <ul style="list-style: none; margin: 0; padding-left: 4px; display: flex; flex-direction: column; gap: 6px;">
                                                    @foreach (var clause in res.SectionClauses)
                                                    {
                                                        <li>@clause</li>
                                                    }
                                                </ul>
                                            }
                                            else
                                            {
                                                <span style="white-space: pre-wrap;">@res.SectionTextFull</span>
                                            }
                                        </div>
                                        <div class="row spread wrap" style="margin-top: 20px; gap: 10px;">
                                            <button class="btn btn-ghost" type="button" data-close-modal data-bn="বন্ধ করুন" data-en="Close">বন্ধ করুন</button>
                                            @if (!User.IsInRole("Lawyer"))
                                            {
                                                <a class="btn btn-primary" asp-controller="Case" asp-action="Submit"
                                                   data-bn="এই ধারা উদ্ধৃত করে মামলা দাখিল →" data-en="File a Case Citing This Section →">
                                                    এই ধারা উদ্ধৃত করে মামলা দাখিল →
                                                </a>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    <!-- Pagination -->
                    @if (totalPages > 1)
                    {
                        <div class="pagination">
                            @if (Model.Page > 1)
                            {
                                <a asp-action="Index" asp-route-q="@Model.Query" asp-route-actId="@Model.ActId" asp-route-page="@(Model.Page - 1)"><i data-lucide="chevron-left"></i></a>
                            }
                            else
                            {
                                <button type="button" disabled><i data-lucide="chevron-left"></i></button>
                            }

                            @* Page numbers render as Bengali numerals by default (data-page carries
                               the real int); main.js re-renders each one in Latin digits when the
                               page is switched to English, same convention as ToBn's callers elsewhere. *@
                            @for (var p = 1; p <= totalPages; p++)
                            {
                                @if (p == Model.Page)
                                {
                                    <button type="button" class="active" data-page="@p">@ToBn(p)</button>
                                }
                                else
                                {
                                    <a asp-action="Index" asp-route-q="@Model.Query" asp-route-actId="@Model.ActId" asp-route-page="@p" data-page="@p">@ToBn(p)</a>
                                }
                            }

                            @if (Model.Page < totalPages)
                            {
                                <a asp-action="Index" asp-route-q="@Model.Query" asp-route-actId="@Model.ActId" asp-route-page="@(Model.Page + 1)"><i data-lucide="chevron-right"></i></a>
                            }
                            else
                            {
                                <button type="button" disabled><i data-lucide="chevron-right"></i></button>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <div class="es-ico"><i data-lucide="search-x"></i></div>
                        <h3>কোনো ধারা খুঁজে পাওয়া যায়নি</h3>
                        <p>অনুগ্রহ করে ভিন্ন কোনো শব্দ বা আইনের নাম দিয়ে আবার অনুসন্ধান করুন।</p>
                    </div>
                }
            </div>

            <!-- Rail / Filter sidebar -->
            <aside class="rail">
                <div class="card" style="background: var(--surface-2);">
                    <div class="kicker">
                        <i data-lucide="help-circle"></i> <span data-bn="অনুসন্ধান সহায়িকা" data-en="Search Tips">অনুসন্ধান সহায়িকা</span>
                    </div>
                    <p class="tiny muted" style="margin-top: 6px; line-height: 1.6;">
                        <span class="i18n-bn">আপনি সুনির্দিষ্ট ধারা নম্বর লিখেও সার্চ করতে পারেন (যেমন: <i>ধারা ১২৩</i> বা <i>Section 123</i>)। উপরের ড্রপডাউন থেকে নির্দিষ্ট আইন ফিল্টার করা যায়।</span>
                        <span class="i18n-en" style="display:none">You can also search for a specific section number directly (e.g. <i>section 123</i> or <i>ধারা ১২৩</i>). Filter by a specific Act using the dropdown above.</span>
                    </p>
                </div>
            </aside>
        </div>
    }
    else
    {
        <div class="empty-state" style="margin: 2rem 0;">
            <div class="es-ico"><i data-lucide="book-marked"></i></div>
            <h3>আইন ও ধারার নাম লিখে অনুসন্ধান শুরু করুন</h3>
            <p class="muted">বাংলাদেশ কোড সংকলন থেকে যেকোনো শব্দ বা ধারার তাৎক্ষণিক রেফারেন্স পান।</p>
        </div>
    }
</main>

<script>
document.addEventListener("DOMContentLoaded", function () {
    var form = document.querySelector("form.search-bar");
    var searchInput = document.querySelector(".search-box-input");
    var root = document.querySelector("[data-act-filter]");

    // If searching something new via the search box (typing or submitting), reset act filter to all acts
    if (form) {
        form.addEventListener("submit", function () {
            var valueInput = document.getElementById("actId-value");
            if (valueInput) {
                valueInput.value = "";
            }
        });
    }

    if (searchInput) {
        searchInput.addEventListener("input", function () {
            var valueInput = document.getElementById("actId-value");
            if (valueInput) {
                valueInput.value = "";
            }
        });
    }

    if (!root) return;
    var btn = document.getElementById("actId-btn");
    var label = document.getElementById("actId-label");
    var valueInput = document.getElementById("actId-value");
    var panel = document.getElementById("actId-panel");
    var list = document.getElementById("actId-list");
    var items = Array.prototype.slice.call(list.querySelectorAll(".act-filter-item"));

    function markSelected() {
        items.forEach(function (it) {
            it.classList.toggle("selected", it.dataset.value === valueInput.value);
        });
        if (valueInput.value) {
            btn.classList.add("active-filter");
        } else {
            btn.classList.remove("active-filter");
        }
    }

    function openPanel() {
        panel.hidden = false;
        root.classList.add("open");
        btn.setAttribute("aria-expanded", "true");
    }

    function closePanel() {
        panel.hidden = true;
        root.classList.remove("open");
        btn.setAttribute("aria-expanded", "false");
    }

    btn.addEventListener("click", function (e) {
        e.preventDefault();
        if (panel.hidden) openPanel(); else closePanel();
    });

    list.addEventListener("click", function (e) {
        var item = e.target.closest(".act-filter-item");
        if (!item) return;
        valueInput.value = item.dataset.value;
        var text = item.querySelector(".item-text") ? item.querySelector(".item-text").textContent : item.textContent;
        label.textContent = text.trim();
        btn.title = text.trim();
        markSelected();
        closePanel();
        btn.focus();

        var parentForm = root.closest("form");
        if (parentForm) {
            parentForm.submit();
        }
    });

    document.addEventListener("click", function (e) {
        if (!root.contains(e.target)) closePanel();
    });

    document.addEventListener("keydown", function (e) {
        if (e.key === "Escape" && !panel.hidden) {
            closePanel();
            btn.focus();
        }
    });
});
</script>
