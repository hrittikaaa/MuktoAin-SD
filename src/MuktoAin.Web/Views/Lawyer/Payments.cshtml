@model LawyerPaymentsViewModel
@using MuktoAin.Web.Controllers
@{
    ViewData["Title"] = "আয় ও পেমেন্ট — মুক্ত আইন";

    // Thousands separators and two decimals, independent of server culture.
    // Amounts carry data-bn (Bengali digits) / data-en so the language switch swaps them.
    static string Bdt(decimal amount) => "৳" + amount.ToString("#,0.00", System.Globalization.CultureInfo.InvariantCulture);

    var totalPages = Model.PageSize > 0
        ? (int)Math.Ceiling(Model.TotalCount / (double)Model.PageSize)
        : 1;
}

<main class="container" id="main">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a asp-controller="Home" asp-action="Index" data-bn="হোম" data-en="Home">হোম</a>
        <span class="sep">/</span>
        <span data-bn="আয় ও পেমেন্ট" data-en="Payments">আয় ও পেমেন্ট</span>
    </nav>

    <div class="page-head">
        <span class="kicker"><i data-lucide="wallet"></i> FR-24</span>
        <h1 class="page-title" data-bn="আয় ও পেমেন্ট" data-en="Earnings & Payments">আয় ও পেমেন্ট</h1>
        <p class="page-sub">@Model.LawyerName · Bar #@Model.BarRegistrationNumber</p>
    </div>

    <div class="card">
        <div class="row spread wrap" style="align-items: center; gap: 10px">
            <div>
                <h2 class="section-h" style="margin:0"><i data-lucide="wallet"></i> <span data-bn="ব্যালেন্স (স্যান্ডবক্স)" data-en="Balance (sandbox)">ব্যালেন্স (স্যান্ডবক্স)</span></h2>
                <span class="badge badge-warn sandbox-badge tiny" style="display: inline-block; margin-top: 8px;" data-bn="ডেমো মোড — স্যান্ডবক্স পেমেন্ট" data-en="Demo mode — sandbox payments">ডেমো মোড — স্যান্ডবক্স পেমেন্ট</span>
            </div>
            <div style="font-size: 32px; font-weight: 700" data-bn="@Numerals.Bn(Bdt(Model.Balance))" data-en="@Bdt(Model.Balance)">@Numerals.Bn(Bdt(Model.Balance))</div>
        </div>
        @if (Model.PendingPayout > 0)
        {
            <p class="tiny muted" style="margin: 8px 0 0">
                <span data-bn="অপেক্ষমাণ পরিশোধের অনুরোধ:" data-en="Payout requested, awaiting admin:">অপেক্ষমাণ পরিশোধের অনুরোধ:</span>
                <b data-bn="@Numerals.Bn(Bdt(Model.PendingPayout))" data-en="@Bdt(Model.PendingPayout)">@Numerals.Bn(Bdt(Model.PendingPayout))</b>
            </p>
        }

        @if (Model.History.Any())
        {
            <table style="margin-top: 16px">
                <thead>
                    <tr>
                        <th data-bn="মামলা" data-en="Case">মামলা</th>
                        <th data-bn="মোট" data-en="Gross">মোট</th>
                        <th data-bn="কমিশন" data-en="Commission">কমিশন</th>
                        <th data-bn="নিট" data-en="Net">নিট</th>
                        <th data-bn="পরিশোধিত" data-en="Paid">পরিশোধিত</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.History)
                    {
                        <tr>
                            <td class="mono">CASE-@e.CaseId</td>
                            <td data-bn="@Numerals.Bn(Bdt(e.Gross))" data-en="@Bdt(e.Gross)">@Numerals.Bn(Bdt(e.Gross))</td>
                            <td data-bn="@Numerals.Bn(Bdt(e.Commission))" data-en="@Bdt(e.Commission)">@Numerals.Bn(Bdt(e.Commission))</td>
                            <td><b data-bn="@Numerals.Bn(Bdt(e.Net))" data-en="@Bdt(e.Net)">@Numerals.Bn(Bdt(e.Net))</b></td>
                            <td class="tiny muted" data-bn="@BdTime.Bn(e.PaidAt, "d MMM yyyy")" data-en="@BdTime.En(e.PaidAt, "d MMM yyyy")">@BdTime.Bn(e.PaidAt, "d MMM yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (totalPages > 1)
            {
                <div class="pagination" style="margin-top: 12px">
                    @if (Model.Page > 1)
                    {
                        <a asp-action="Payments" asp-route-page="@(Model.Page - 1)"><i data-lucide="chevron-left"></i></a>
                    }
                    @foreach (var p in Pager.Window(Model.Page, totalPages))
                    {
                        @if (p is null)
                        {
                            <span class="muted" aria-hidden="true">…</span>
                        }
                        else if (p == Model.Page)
                        {
                            <button type="button" class="active" data-page="@p" data-bn="@Numerals.Bn(p.Value.ToString())" data-en="@p">@Numerals.Bn(p.Value.ToString())</button>
                        }
                        else
                        {
                            <a asp-action="Payments" asp-route-page="@p" data-bn="@Numerals.Bn(p.Value.ToString())" data-en="@p">@Numerals.Bn(p.Value.ToString())</a>
                        }
                    }
                    @if (Model.Page < totalPages)
                    {
                        <a asp-action="Payments" asp-route-page="@(Model.Page + 1)"><i data-lucide="chevron-right"></i></a>
                    }
                </div>
            }
        }
        else
        {
            <p class="muted tiny" style="margin-top: 12px" data-bn="এখনো কোনো সম্মানী নেই।" data-en="No honoraria yet.">এখনো কোনো সম্মানী নেই।</p>
        }

        <form asp-action="RequestPayout" method="post" style="margin-top: 16px">
            @Html.AntiForgeryToken()
            <button class="btn btn-outline btn-sm" type="submit" @(Model.Balance <= 0 || Model.PendingPayout > 0 ? "disabled" : "")>
                <i data-lucide="banknote"></i> <span data-bn="পরিশোধ চান" data-en="Request payout">পরিশোধ চান</span>
            </button>
        </form>
    </div>
</main>
