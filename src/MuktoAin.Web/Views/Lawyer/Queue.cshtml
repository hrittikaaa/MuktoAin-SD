@model LawyerQueueViewModel
@using MuktoAin.Web.Controllers
@{
    ViewData["Title"] = "রিভিউ কিউ — মুক্ত আইন";

    // Display-only Bengali numeral rendering, same convention as
    // Lawyer/History.cshtml's pagination.
    static string ToBn(int n) => n.ToString()
        .Select(c => char.IsDigit(c) ? (char)(c - '0' + '০') : c)
        .Aggregate(new System.Text.StringBuilder(), (sb, c) => sb.Append(c))
        .ToString();

    var totalPages = Model.PageSize > 0
        ? (int)Math.Ceiling(Model.TotalCount / (double)Model.PageSize)
        : 1;
}

<main class="container" id="main">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a asp-controller="Home" asp-action="Index" data-bn="হোম" data-en="Home">হোম</a>
        <span class="sep">/</span>
        <span data-bn="রিভিউ কিউ" data-en="Review Queue">রিভিউ কিউ</span>
    </nav>

    <div class="page-head">
        <span class="kicker"><i data-lucide="file-check-2"></i> FR-13 · FR-23</span>
        <h1 class="page-title" data-bn="পর্যালোচনা কিউ" data-en="Review Queue">পর্যালোচনা কিউ</h1>
        <p class="page-sub">@Model.LawyerName</p>
    </div>

    <!-- KPI strip -->
    <div class="grid grid-3" style="margin-bottom: 20px">
        <div class="card">
            <span class="kicker"><i data-lucide="inbox"></i> <span data-bn="অপেক্ষমাণ" data-en="Pending">অপেক্ষমাণ</span></span>
            <div style="font-size: 32px; font-weight: 700">@Model.PendingCount</div>
        </div>
        <div class="card">
            <span class="kicker"><i data-lucide="badge-check"></i> <span data-bn="বার যাচাইকৃত" data-en="Bar Verified">বার যাচাইকৃত</span></span>
            <div style="font-size: 18px; font-weight: 700; margin-top: 8px">@Model.BarRegistrationNumber</div>
        </div>
        <div class="card">
            <span class="kicker"><i data-lucide="layers"></i> <span data-bn="বিশেষজ্ঞতা" data-en="Specialization">বিশেষজ্ঞতা</span></span>
            <div style="font-size: 18px; font-weight: 700; margin-top: 8px">@Model.Specialization</div>
        </div>
    </div>

    <!-- Filter chips: All · Unclaimed · Mine · My field -->
    <div class="chip-row" style="margin-bottom: 16px">
        @foreach (var f in new[] { "All", "Unclaimed", "Mine", "MyField" })
        {
            <a class="chip chip-sm @(Model.ActiveFilter == f ? "active" : "")"
               asp-action="Queue" asp-route-filter="@f">
                @(f switch
                {
                    "All" => "সকল / All",
                    "Unclaimed" => "অনাবৃত / Unclaimed",
                    "Mine" => "আমার নেওয়া / Mine",
                    _ => "আমার বিষয় / My field"
                })
            </a>
        }
    </div>

    @if (Model.FieldFallback)
    {
        <div class="alert alert-info tiny" role="note" style="margin-bottom: 16px">
            <span data-bn="আপনার বিশেষজ্ঞতার ক্ষেত্র কোনো মামলার বিভাগের সাথে মেলেনি, তাই সব নথি দেখানো হচ্ছে।"
                  data-en="Your specialization doesn't match any case category, so all documents are shown.">আপনার বিশেষজ্ঞতার ক্ষেত্র কোনো মামলার বিভাগের সাথে মেলেনি, তাই সব নথি দেখানো হচ্ছে।</span>
            <a asp-controller="Account" asp-action="Profile" data-bn="প্রোফাইলে যোগ করুন" data-en="Update it in your profile">প্রোফাইলে যোগ করুন</a>
            <partial name="_SpecializationHint" />
        </div>
    }

    @if (!Model.Items.Any())
    {
        <div class="empty-state">
            <div class="item-ico"><i data-lucide="coffee"></i></div>
            <h3 data-bn="কিউ খালি — ধন্যবাদ!" data-en="Queue empty — thank you!">কিউ খালি — ধন্যবাদ!</h3>
            <p class="muted" data-bn="এই মুহূর্তে অপেক্ষমাণ কোনো নথি নেই।" data-en="No documents awaiting review right now.">এই মুহূর্তে অপেক্ষমাণ কোনো নথি নেই।</p>
        </div>
    }
    else
    {
        <div class="card">
            <table>
                <thead>
                    <tr>
                        <th data-bn="নথি" data-en="Doc">নথি</th>
                        <th data-bn="বিভাগ" data-en="Category">বিভাগ</th>
                        <th data-bn="জেলা" data-en="District">জেলা</th>
                        <th data-bn="অপেক্ষা (SLA)" data-en="Waiting (SLA)">অপেক্ষা (SLA)</th>
                        <th data-bn="সংস্করণ" data-en="Version">সংস্করণ</th>
                        <th data-bn="অবস্থা" data-en="Status">অবস্থা</th>
                        <th data-bn="পদক্ষেপ" data-en="Action">পদক্ষেপ</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var q in Model.Items)
                    {
                        <tr>
                            <td class="mono">DOC-@q.DocumentId<br /><small class="muted">@q.CaseTitle</small></td>
                            <td>@q.CategoryName</td>
                            <td>@q.DistrictName</td>
                            <td>
                                <span class="badge badge-@(q.WaitingHours >= 24 ? "rejected" : "neutral")">@q.WaitingHours h</span>
                            </td>
                            <td>
                                v@(q.VersionNo)
                                @if (q.CitizenEdited)
                                {
                                    <span class="tiny muted" data-bn="· সম্পাদিত" data-en="· edited">· সম্পাদিত</span>
                                }
                            </td>
                            <td>
                                @if (q.IsMine)
                                {
                                    <span class="badge badge-final" data-bn="আমার নেওয়া" data-en="Mine">আমার নেওয়া</span>
                                }
                                else if (q.IsClaimed)
                                {
                                    <span class="badge badge-review" data-bn="অন্য আইনজীবীর নেওয়া" data-en="Claimed by another lawyer">অন্য আইনজীবীর নেওয়া</span>
                                }
                                else
                                {
                                    <span class="badge badge-draft" data-bn="অনাবৃত" data-en="Unclaimed">অনাবৃত</span>
                                }
                            </td>
                            <td>
                                @if (q.CanOpen)
                                {
                                    <form asp-action="Claim" asp-route-documentId="@q.DocumentId" method="post" style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <button class="btn @(q.IsMine ? "btn-outline" : "btn-primary") btn-sm" type="submit">
                                            <i data-lucide="eye"></i>
                                            @if (q.IsMine)
                                            {
                                                <span data-bn="চালিয়ে যান" data-en="Continue">চালিয়ে যান</span>
                                            }
                                            else
                                            {
                                                <span data-bn="পর্যালোচনা" data-en="Review">পর্যালোচনা</span>
                                            }
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button class="btn btn-outline btn-sm" type="button" disabled
                                            title="অন্য আইনজীবীর নিয়ন্ত্রণে / Claimed by another lawyer">
                                        <i data-lucide="lock"></i> <span data-bn="লক করা" data-en="Locked">লক করা</span>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <p class="muted tiny" style="margin: 12px 0 0" data-bn="নথি খুললেই সেটি আপনার নামে লক হয় (একসময়ে একটি পর্যালোচনা)।" data-en="Opening a document claims it for you (one active review at a time).">নথি খুললেই সেটি আপনার নামে লক হয় (একসময়ে একটি পর্যালোচনা)।</p>
            @if (totalPages > 1)
            {
                <div class="pagination" style="margin-top: 12px">
                    @if (Model.Page > 1)
                    {
                        <a asp-action="Queue" asp-route-filter="@Model.ActiveFilter" asp-route-page="@(Model.Page - 1)"><i data-lucide="chevron-left"></i></a>
                    }
                    @foreach (var p in Pager.Window(Model.Page, totalPages))
                    {
                        @if (p is null)
                        {
                            <span class="muted" aria-hidden="true">…</span>
                        }
                        else if (p == Model.Page)
                        {
                            <button type="button" class="active" data-page="@p">@ToBn(p.Value)</button>
                        }
                        else
                        {
                            <a asp-action="Queue" asp-route-filter="@Model.ActiveFilter" asp-route-page="@p">@ToBn(p.Value)</a>
                        }
                    }
                    @if (Model.Page < totalPages)
                    {
                        <a asp-action="Queue" asp-route-filter="@Model.ActiveFilter" asp-route-page="@(Model.Page + 1)"><i data-lucide="chevron-right"></i></a>
                    }
                </div>
            }
        </div>
    }
</main>
